# Suppressions to use with libabigail tools (abidw, abidiff, etc)
#
# This excludes:
#
# - The C stdlib FILE struct's internals (surprised this is not part of the
#   the default suppressions already).
#

[suppress_type]
  name = _IO_FILE
  type_kind = struct
  drop = yes
  label = libabigail::OPAQUE_TYPE_LABEL
